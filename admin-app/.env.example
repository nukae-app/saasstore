# Base de la API real. Por defecto ya apunta a docker compose local
# (localhost:8080, con el alias de Android hacia el host), ver lib/config.ts.
# Solo hace falta esto para un DISPOSITIVO FÍSICO en la misma red — sustituye
# por la IP de LAN de tu máquina, p. ej.:
# EXPO_PUBLIC_API_URL=http://192.168.1.23:8080/api
