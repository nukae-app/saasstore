# Fase 4 (roadmap de superadmin): TLS on-demand para dominios de tenant
# dados de alta después del deploy — sin esto, un tenant nuevo con `domain`
# propio (ver POST/PATCH /superadmin/tenants) queda creado en BD pero no
# sirve tráfico hasta editar este Caddyfile a mano y redesplegar. `ask`
# consulta a la API (api/app/routers/internal.py::ask_domain, container a
# container, nunca a través de este mismo Caddy) antes de pedir un
# certificado nuevo a Let's Encrypt — así un hostname aleatorio que
# resuelva aquí no puede disparar peticiones de certificado y agotar el
# rate limit de la cuenta ACME, y un tenant suspendido (Tenant.activo=False)
# tampoco consigue certificado nuevo.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:8000/internal/caddy/ask-domain
	}
}

www.{$SITE_ADDRESS} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}

# Panel de superadmin (SUPERADMIN_HOST) y landing SaaS (NEXT_PUBLIC_APP_HOST):
# ELIMINADOS deliberadamente de este Caddyfile (docs/PLAN_SEGURETAT_COMPLIMENT.md,
# Fase 5 opción A). El SaaS multi-tenant no se comercializa y ultra-local es
# el único tenant, así que ninguno de los dos dominios debe servir tráfico.
# El código (rutas /superadmin, middleware, _require_superadmin_host) se
# mantiene; para reactivarlos basta con volver a añadir un bloque
# `{$SUPERADMIN_HOST} { encode gzip \n import api_proxy \n import web_proxy }`.

# Fragmentos comunes: antes cada bloque repetía el proxy y las cabeceras y
# divergían (p. ej. /api/metrics solo se bloqueaba en algunos).
(api_proxy) {
	# /metrics (Prometheus) es reserva per a Alloy, dins la xarxa Docker
	# (api:8000/metrics directament, sense passar per Caddy).
	handle /api/metrics {
		respond 404
	}

	# /internal/* només l'ha de cridar Caddy mateix (ask-domain).
	handle /api/internal/* {
		respond 404
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8000
	}
}

(web_proxy) {
	# Las facturas de gastos son PRIVADAS (S3 private/, URLs firmadas desde la API):
	# jamás se sirven por /uploads, ni aunque alguien conozca el nombre.
	handle /uploads/despeses/* {
		respond 404
	}

	# Subidas públicas (imágenes, vídeos, tipografías): viven en S3 y las sirve
	# CloudFront. Se mantiene la ruta /uploads/... (mismo origen: sin CORS ni
	# cambios de CSP) y las URLs guardadas en la BD no cambian.
	# UPLOADS_CDN_HOST = dominio de CloudFront (terraform-uploads, output cdn_domain).
	handle /uploads/* {
		uri strip_prefix /uploads
		header X-Content-Type-Options "nosniff"
		reverse_proxy https://{$UPLOADS_CDN_HOST} {
			header_up Host {upstream_hostport}
		}
	}

	handle {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "geolocation=(), camera=(), microphone=()"
			X-Frame-Options "SAMEORIGIN"
			# CSP en mode REPORT-ONLY (no bloqueja res): les violacions arriben a
			# POST /api/csp-report (es registren al log de l'API). Passar a
			# `Content-Security-Policy` un cop revisades (Fase 2.2 del pla).
			# 'unsafe-inline' a script/style perquè Next.js injecta scripts
			# inline sense nonce; es pot estrènyer més endavant.
			Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://faro-collector-prod-eu-west-6.grafana.net; frame-src https://*.s3.eu-west-1.amazonaws.com https://www.mixcloud.com https://*.bandcamp.com https://w.soundcloud.com https://open.spotify.com https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self' https://sis.redsys.es https://sis-t.redsys.es; frame-ancestors 'self'; report-uri /api/csp-report"
			-X-Powered-By
		}
		reverse_proxy web:3000
	}
}

{$SITE_ADDRESS} {
	encode gzip
	import api_proxy
	import web_proxy
}

# Fase 4: dominis de tenant donats d'alta des del superadmin DESPRÉS
# d'aquest deploy — {$SITE_ADDRESS}/{$SUPERADMIN_HOST} de dalt són blocs
# explícits, Caddy sempre els prioritza sobre aquest catch-all, així que no
# xoquen. TLS on-demand (`tls { on_demand }`) usa el bloc global `ask` de
# dalt d'aquest fitxer per decidir si val la pena demanar un certificat.
https:// {
	encode gzip
	tls {
		on_demand
	}

	# www.<dominio del tenant> → dominio sin www, genérico para cualquier
	# dominio propio dado de alta después del deploy (a diferencia del
	# redirect de www.{$SITE_ADDRESS} de arriba, que solo cubre ese
	# dominio). ask-domain (internal.py) ya acepta la variante "www." como
	# alias válido para que Caddy pueda completar el TLS handshake antes de
	# poder devolver este redirect — sin eso la conexión ni se establecía.
	@www header_regexp host Host ^www\.(.+)$
	handle @www {
		redir https://{re.host.1}{uri} permanent
	}

	import api_proxy
	import web_proxy
}
