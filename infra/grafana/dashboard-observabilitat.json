        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "topk(10, sum by (page_id) (count_over_time({service_name=\"labotigaaquesta\"} | logfmt | event_name=\"page_view\" [$__range])))",
          "queryType": "instant"
