      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "page_id": "Pàgina",
              "Value #A": "Visites"
            }
          }
        }
      ]
    },
