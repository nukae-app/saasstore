      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "topk(8, sum by (event_data_referrer) (count_over_time({service_name=\"labotigaaquesta\"} | logfmt | event_name=\"page_view\" | event_data_referrer!=\"\" [$__range])))",
