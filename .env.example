# ── Base de dades ────────────────────────────────────────────
# Local (Docker Compose): la URL es construeix automàticament des de les variables
# Producció (EC2 + RDS): defineix DATABASE_URL directament i deixa les altres buides
# DATABASE_URL=postgresql+psycopg://user:password@rds-endpoint.rds.amazonaws.com:5432/ultralocal
POSTGRES_DB=ultralocal
POSTGRES_USER=ultralocal
POSTGRES_PASSWORD=

# Nombre de processos Uvicorn de l'api. Per defecte 2 (un per vCPU de
# l'EC2 t2.medium actual). Si es puja la mida de la instància, pujar-ho en
# proporció als vCPU nous (veure comentari al Dockerfile).
# UVICORN_WORKERS=2

# Pool de connexions SQLAlchemy — valor PER PROCÉS (l'api en crea
# UVICORN_WORKERS, el worker en crea CELERY_CONCURRENCY). Per defecte
# pensats per RDS db.t4g.micro (max_connections ~79) amb UVICORN_WORKERS=2;
# si es puja la instància RDS o UVICORN_WORKERS, recalcular (veure comentari
# a app/config.py).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=10

# ── Seguretat ────────────────────────────────────────────────
# openssl rand -hex 32
SECRET_KEY=

# ── Google OAuth (opcional) ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email / Magic links (opcional) ───────────────────────────
# Brevo SMTP: smtp-relay.brevo.com:587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitent que veu el client. Sense això, cau al valor per defecte del codi
# (un gmail de proves) — a producció s'ha de definir sempre.
EMAIL_FROM=Ultra-Local Records <info@labotigaaquesta.com>

# ── Discogs API (opcional, per a l'alta de discos) ───────────
DISCOGS_TOKEN=

# ── Sincronització nocturna del catàleg amb el Google Sheet ──
# URL d'export CSV públic del sheet (Arxiu → Compartir → "Qualsevol amb
# l'enllaç" ha d'estar activat). Buit = la tasca nocturna no fa res.
CATALOG_SHEET_CSV_URL=
# Email on rebre el resum de cada sincronització (opcional)
CATALOG_SYNC_NOTIFY_EMAIL=

# ── IA (opcional, per a expansió intel·ligent de recomanacions) ──
# Millora les recomanacions de Spotify entenent relacions musicals
# Obté la clau a console.anthropic.com — model: claude-haiku-4-5 (~0.001€/consulta)
ANTHROPIC_API_KEY=

# ── Redsys / TPV Virtual (pasarela de pago, ex: via Kutxabank) ──
# Datos que da el banco al activar el TPV virtual (uno para pruebas,
# otro para producción). Sin esto el checkout se queda en pendiente_pago.
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=
REDSYS_ENVIRONMENT=test
# URL pública a la que Redsys llama server-to-server tras el cobro
REDSYS_NOTIFY_URL=https://<domini>/api/checkout/pay/redsys/notify

# ── Spotify (opcional, per a recomanacions de catàleg) ───────
# Kill switch global: posa-ho a false per desactivar tot el mòdul (rutes
# /api/auth/spotify/* i secció al frontend) sense tocar codi ni dades.
SPOTIFY_ENABLED=true
# Registra l'app a developer.spotify.com → Dashboard → Create app
# Redirect URI a configurar: https://<domini>/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Web / Caddy ──────────────────────────────────────────────
# Local: localhost | Producció: el teu domini, ex: ultralocal.cat
# Nomes el domini arrel (sense www): Caddy redirigeix www -> arrel automaticament.
SITE_ADDRESS=localhost
# Requerit per Let's Encrypt (avisos de caducitat/problemes de certificat) i
# necessari per al TLS on-demand dels dominis de tenant donats d'alta des
# del superadmin (Fase 4, veure infra/Caddyfile). Nomes es fa servir en
# producció (docker-compose.prod.yml) — Caddyfile.local no en depèn.
ACME_EMAIL=admin@example.com
# Base per als enllaços que es posen dins dels emails (magic link, verificació,
# baixa de newsletter...). Sense això cau a "http://localhost" — a producció
# ha de ser el domini públic amb https.
FRONTEND_URL=https://labotigaaquesta.com

# ── Dev ──────────────────────────────────────────────────────
# Posa 'true' per saltar l'autenticació admin en local
NEXT_PUBLIC_DEV_ADMIN_BYPASS=false

# ── Superadmin (Fase 3) ──────────────────────────────────────
# Domini dedicat del panell de plataforma — ha de coincidir amb
# SUPERADMIN_HOST del backend (api/app/config.py::SuperAdminSettings).
# El front el fa servir només per decidir si mostra el panell (gate real:
# _require_superadmin_host al backend).
NEXT_PUBLIC_SUPERADMIN_HOST=superadmin.localhost
SUPERADMIN_HOST=superadmin.localhost

# ── Landing de producte (NukaeStore) ──────────────────────────
# Domini propi de l'app (no d'un tenant): la seva arrel serveix la landing
# de /nukaestore en comptes d'intentar resoldre un tenant. Local: localhost
# a seques (cap tenant hauria de fer servir aquest domain). Producció: el
# domini públic del producte, ex: nukaestore.com.
NEXT_PUBLIC_APP_HOST=localhost

# Domini base sota el qual "neix" cada tenant nou (<slug>.platform_domain)
# fins que configura el seu propi domini — ver
# api/app/config.py::SuperAdminSettings.platform_domain i
# routers/superadmin.py::create_tenant(). Requereix un DNS wildcard
# (*.platform_domain) apuntant al mateix servidor; local: localhost a
# seques (els tenants de dev fan servir "<slug>.localhost" a mà igualment).
PLATFORM_DOMAIN=localhost

# ── Facturació de plataforma (Revolut Business) ─────────────
# Signing secret dels webhooks de POST /api/webhooks/revolut (facturació
# SaaS als tenants, NO el checkout de cada botiga). Buit = el webhook
# rebutja qualsevol payload (ver api/app/routers/billing_webhooks.py).
# Encara no hi ha credencials de sandbox de Revolut — omplir quan n'hi hagi.
REVOLUT_WEBHOOK_SIGNING_SECRET=
